TWILIO_AUTH_TOKEN = "add your Twilio auth token here"
TWILIO_FROM_PHONE_NUMBER = "add your Twilio phone number here"  # Twilio temporary phone number (sender)
TWILIO_TO_PHONE_NUMBER = "add recipient's phone number here"  # recipient's phone number (receiver)
EMAIL_RECEIVER = "add recipient's email here"
