GEMINI_API_KEY=""
IMAP_SERVER = "imap.gmail.com"  # Change if using Outlook/Yahoo
EMAIL_SERVER = "smtp.gmail.com"
EMAIL_PORT = 465  # Port for SSL connections
EMAIL_USER = "add your email here"
EMAIL_PASS = "add your email password here"  # Use an App Password, not account password
TARGET_DOMAIN = "add your target domain here"
LOG_LEVEL = "DEBUG"  # Options: DEBUG, INFO, WARNING, ERROR, CRITICAL
